# ---------------------------------------------------------------------------
# Core application
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=Marcateplace2

# Optional public store URL used for payment redirects. Falls back to
# BETTER_AUTH_URL / NEXT_PUBLIC_SERVER_URL.
# FRONTEND_URL=https://your-store.example.com

# ---------------------------------------------------------------------------
# Jonota Pay (FahimFaysal) online payments
# ---------------------------------------------------------------------------
# Server-only API key. NEVER expose this to the browser and never commit it.
JONOTA_PAY_API_KEY=

# Provider endpoints (defaults shown; override only if the provider changes them)
JONOTA_PAY_CREATE_URL=https://client.fahimfaysal.shop/api/payment/create
JONOTA_PAY_VERIFY_URL=https://client.fahimfaysal.shop/api/payment/verify
JONOTA_PAY_TIMEOUT_MS=20000

# The docs table says `meta_data` while the samples use `metadata`. The server
# sends both by default. Set to `metadata` or `meta_data` if the provider
# rejects the extra field.
# JONOTA_PAY_METADATA_FIELD=both

# Optional currency field (not documented by the provider).
# JONOTA_PAY_CURRENCY=BDT

# Optional URL overrides. {orderId} and {orderNumber} are replaced per order.
# JONOTA_PAY_SUCCESS_URL=https://your-store.example.com/api/payments/jonota/callback/{orderId}
# JONOTA_PAY_CANCEL_URL=https://your-store.example.com/payment/cancel/{orderId}
# JONOTA_PAY_WEBHOOK_URL=https://your-store.example.com/api/payments/jonota/webhook

# ---------------------------------------------------------------------------
# Stripe (existing optional online card payments)
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Email / jobs (existing optional integrations)
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
# MAIL_FROM=
# CRON_SECRET=
